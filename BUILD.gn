# Host(Linux) unit test entry for ets_utils.
# Build:  ./build.sh --product-name rk3568 --build-target ets_utils_host_unittest
# Output: out/rk3568/clang_x64/tests/unittest/ets_utils/...
group("ets_utils_host_unittest") {
  testonly = true
  deps = []
  if (host_os == "linux") {
    deps += [
      "//commonlibrary/ets_utils/js_api_module/buffer/test:test_buffer_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_api_module/convertxml/test:test_convertxml_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_api_module/uri/test:test_uri_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_api_module/url/test:test_url_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_api_module/xml/test:test_xml_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_concurrent_module/taskpool/test:test_taskpool_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_concurrent_module/test:test_concurrent_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_concurrent_module/utils/test:test_utils_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_concurrent_module/worker/test:test_worker_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_sys_module/console/test:test_console_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_sys_module/timer/test:test_timer_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_sys_module/test:test_process_unittest($host_toolchain)",
      "//commonlibrary/ets_utils/js_util_module/util/test:test_util_unittest($host_toolchain)",
    ]
  }
}
