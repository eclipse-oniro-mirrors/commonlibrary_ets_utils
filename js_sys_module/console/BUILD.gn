import("//build/ohos.gni")
import("//commonlibrary/ets_utils/ets_utils_config.gni")

config("console_public_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "${sys_module}/console",
    js_concurrent_module_common,
  ]
}

ohos_shared_library("console") {
  branch_protector_ret = "pac_ret"
  branch_protector_frt = "bti"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  include_dirs = [
    "../../js_concurrent_module/common",
    "../console",
  ]

  public_configs = [ ":console_public_config" ]

  sources = [
    "../../js_concurrent_module/common/helper/napi_helper.cpp",
    "console.cpp",
  ]

  deps = []

  external_deps = [
    "napi:ace_napi",
    "node:node_header_notice",
    "libuv:uv",
  ]

  # libhilog_linux is not a registered innerapi (the "innerkits:" component
  # does not exist and a raw cross-part label fails deps validation), so the
  # SDK host branch links hilog:libhilog, whose is_linux branch compiles the
  # same libhilog_source_linux host implementation.
  if (is_linux && current_toolchain == host_toolchain && product_name == "ohos-sdk") {
    external_deps += [ "hilog:libhilog" ]
    defines = [
      "LINUX_PLATFORM",
      "PREVIEW",
    ]
  } else if (is_mingw) {
    external_deps += [ "hilog:libhilog" ]
    defines = [
      "WINDOWS_PLATFORM",
      "NOGDI",
    ]
  } else if (is_mac && !is_arkui_x) {
    external_deps += [ "hilog:libhilog" ]
  } else if (is_standard_system) {
    external_deps += [ "hilog:libhilog" ]
  } else if (is_arkui_x) {
    if (target_os == "ios") {
      deps += [ "$hilog_ios" ]
    } else if (target_os == "android") {
      deps += [ "$hilog_android" ]
    }
  } else {
    external_deps += [ "hilog:libhilog" ]
  }
  cflags = [ "-std=c++17" ]

  if (is_ohos && target_cpu == "arm64") {
    version_script = "libconsole.map"
  }

  subsystem_name = "commonlibrary"
  innerapi_tags = [ "platformsdk_indirect" ]
  part_name = "ets_utils"
}

ohos_source_set("console_static") {
  branch_protector_ret = "pac_ret"
  branch_protector_frt = "bti"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  include_dirs = [
    js_concurrent_module_common,
    "../console",
  ]

  sources = [
    "$js_concurrent_module_common/helper/napi_helper.cpp",
    "console.cpp",
  ]

  external_deps = [
    "napi:ace_napi",
    "node:node_header_notice",
    "libuv:uv",
  ]

  defines = []

  if (is_arkui_x) {
    include_dirs += [
      "$plugins_root/hilog/include",
      "$plugins_root/interfaces",
    ]
    if (target_os == "android") {
      defines += [ "ANDROID_PLATFORM" ]
    }
    if (target_os == "ios") {
      defines += [ "IOS_PLATFORM" ]
    }
  } else {
    external_deps += [ "hilog:libhilog" ]
  }

  if (is_linux && current_toolchain == host_toolchain) {
    # host(Linux) UT: hilog is not available in minimal part sets; logging is
    # a no-op via ETS_UTILS_HOST_UT in log.h.
    defines += [ "ETS_UTILS_HOST_UT" ]
    external_deps -= [ "hilog:libhilog" ]
    # Variables used only by HILOG calls become unused once logging is a
    # no-op on the host; silence the diagnostics for the host build.
    cflags_cc = [
      "-Wno-unused-variable",
      "-Wno-unused-const-variable",
    ]
  }

  subsystem_name = "commonlibrary"
  part_name = "ets_utils"
}

group("console_packages") {
  deps = [ ":console" ]
}
