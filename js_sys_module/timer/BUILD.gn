import("//build/ohos.gni")
import("//commonlibrary/ets_utils/ets_utils_config.gni")

config("timer_public_config") {
  include_dirs = [
    "${sys_module}/timer",
    js_concurrent_module_common,
  ]
}

ohos_shared_library("timer") {
  branch_protector_ret = "pac_ret"
  branch_protector_frt = "bti"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  include_dirs = [
    "../../js_concurrent_module/common",
    "../timer",
    ets_util_path,
  ]

  sources = [
    "../../js_concurrent_module/common/helper/napi_helper.cpp",
    "sys_timer.cpp",
  ]

  deps = []

  public_configs = [ ":timer_public_config" ]

  defines = []

  external_deps = [
    "napi:ace_napi",
    "node:node_header_notice",
    "libuv:uv",
  ]

  # libhilog_linux is not a registered innerapi (the "innerkits:" component
  # does not exist and a raw cross-part label fails deps validation), so the
  # SDK host branch links hilog:libhilog, whose is_linux branch compiles the
  # same libhilog_source_linux host implementation. Keep this branch only for
  # the LINUX_PLATFORM/PREVIEW defines and the host(UT) fallback below.
  if (is_linux && current_toolchain == host_toolchain && product_name == "ohos-sdk") {
    # SDK host build: real hilog logging.
    external_deps += [ "hilog:libhilog" ]
    defines += [
      "LINUX_PLATFORM",
      "PREVIEW",
    ]
  } else if (is_linux && current_toolchain == host_toolchain) {
    # host(UT) build: hilog is not available in minimal part sets; logging is
    # a no-op via ETS_UTILS_HOST_UT in tools/log.h.
    defines += [
      "LINUX_PLATFORM",
      "PREVIEW",
      "ETS_UTILS_HOST_UT",
    ]
    # Variables used only by HILOG calls become unused once logging is a
    # no-op on the host; silence the diagnostics for the host build.
    cflags_cc = [
      "-Wno-unused-variable",
      "-Wno-unused-const-variable",
    ]
  } else {
    if (is_standard_system) {
      external_deps += [ "hilog:libhilog" ]
    } else {
      external_deps += [ "hilog:libhilog" ]
    }
  }

  if (!is_mingw && !is_mac && !is_linux && product_name != "ohos-sdk") {
    defines += [ "ENABLE_CONTAINER_SCOPE" ]
    if (!is_arkui_x) {
      external_deps += [ "hitrace:hitrace_meter" ]
      defines += [ "ENABLE_HITRACE_HELPER_METER" ]
    }
  }

  if (is_mingw) {
    defines += [
      "WINDOWS_PLATFORM",
      "NOGDI",
    ]
  }
  cflags = [ "-std=c++17" ]

  if (is_ohos && target_cpu == "arm64") {
    version_script = "libtimer.map"
  }

  subsystem_name = "commonlibrary"
  innerapi_tags = [ "platformsdk" ]
  part_name = "ets_utils"
}

ohos_source_set("timer_static") {
  branch_protector_ret = "pac_ret"
  branch_protector_frt = "bti"
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  include_dirs = [
    js_concurrent_module_common,
    "../timer",
    ets_util_path,
  ]

  sources = [
    "$js_concurrent_module_common/helper/napi_helper.cpp",
    "sys_timer.cpp",
  ]

  deps = []

  defines = []

  external_deps = [
    "napi:ace_napi",
    "node:node_header_notice",
    "libuv:uv",
  ]
  if (is_arkui_x) {
    include_dirs += [
      "$plugins_root/hilog/include",
      "$plugins_root/interfaces",
      "//base/hiviewdfx/hilog/interfaces/native/innerkits/include",
    ]
    deps += [
      "$plugins_root/libs/napi:napi_${target_os}",
      "$plugins_root/libs/uv:uv_${target_os}",
    ]
    if (target_os == "android") {
      defines += [ "ANDROID_PLATFORM" ]
    }
    if (target_os == "ios") {
      defines += [ "IOS_PLATFORM" ]
    }
  } else {
    external_deps += [ "hilog:libhilog" ]
  }

  if (!is_mingw && !is_mac && !is_linux && product_name != "ohos-sdk") {
    if (!is_arkui_x) {
      external_deps += [ "hitrace:hitrace_meter" ]
      defines += [ "ENABLE_HITRACE_HELPER_METER" ]
    }
    defines += [ "ENABLE_CONTAINER_SCOPE" ]
  }

  if (is_linux && current_toolchain == host_toolchain) {
    # host(Linux) UT: align platform macros with the linux host toolchain and
    # drop the hilog part (logging is a no-op via ETS_UTILS_HOST_UT).
    defines += [
      "LINUX_PLATFORM",
      "PREVIEW",
      "ETS_UTILS_HOST_UT",
    ]
    external_deps -= [ "hilog:libhilog" ]
    # Variables used only by HILOG calls become unused once logging is a
    # no-op on the host; silence the diagnostics for the host build.
    cflags_cc = [
      "-Wno-unused-variable",
      "-Wno-unused-const-variable",
    ]
  }

  subsystem_name = "commonlibrary"
  part_name = "ets_utils"
}

group("timer_packages") {
  deps = [ ":timer" ]
}
